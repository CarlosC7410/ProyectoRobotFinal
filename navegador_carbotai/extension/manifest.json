{
  "manifest_version": 3,
  "name": "Carbotai - Control local de Chromium",
  "version": "1.4.0",
  "description": "Control local de ventanas y pestañas mediante mensajería nativa. Sin scripts en páginas, sin conexión de red propia.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Carbotai - conexión local"
  }
}
